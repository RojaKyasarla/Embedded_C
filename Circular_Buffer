#include <stdio.h>

#define SIZE 5

int buffer[SIZE];
int head = 0;
int tail = 0;

void push(int data)
{
    buffer[head] = data;
    head = (head + 1) % SIZE;
}

int pop()
{
    int value = buffer[tail];
    tail = (tail + 1) % SIZE;
    return value;
}

int main()
{
    push(10);
    push(20);

    printf("%d\n", pop());
    printf("%d\n", pop());

    return 0;
}
