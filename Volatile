#include <stdint.h>

#define GPIO_STATUS (*(volatile uint32_t *)0x40020010)

int main()
{
    while((GPIO_STATUS & (1 << 3)) == 0)
    {
        // Wait until pin becomes HIGH
    }

    return 0;
}
