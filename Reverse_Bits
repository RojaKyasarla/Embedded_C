#include <stdio.h>

int main()
{
    unsigned char num = 13; // Char data type
    unsigned char rev = 0;

    for(int i = 0; i < 8; i++)
    {
        rev <<= 1;
        rev |= (num & 1);
        num >>= 1;
    }

    printf("%u", rev);

    return 0;
}

